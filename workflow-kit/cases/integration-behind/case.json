{
  "title": "A claim on an integration branch merges the default branch in first",
  "rules": ["14.1", "14.3"],
  "runner": {
    "login": "acme-alice",
    "defaultBranch": "main"
  },
  "origin": {
    "branches": ["main", "client"],
    "behind": ["client"]
  },
  "issues": {
    "client": ["acme-alice"]
  },
  "expect": {
    "ready": ["client/c-1"],
    "claim": {
      "branch": "avoozl/client/c-1",
      "base": "client",
      "mergeBase": true
    }
  }
}
