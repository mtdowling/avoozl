{
  "title": "A ready pull request is opened and left to a person",
  "rules": ["14.3"],
  "runner": {
    "login": "acme-alice",
    "defaultBranch": "main"
  },
  "origin": {
    "branches": ["main", "avoozl/parser/p-2"],
