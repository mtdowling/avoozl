{
  "title": "GitHub's own signature on a web commit names no approver",
  "rules": ["7.2"],
  "runner": {
    "login": "acme-alice",
    "defaultBranch": "main"
  },
  "approvers": ["acme-owner"],
  "history": [
    {
      "commit": "1",
      "author": "acme-owner",
      "signer": "web-flow"
    }
  ],
  "origin": {
    "branches": ["main"],
    "behind": []
  },
  "issues": {
    "parser": ["acme-alice"]
  },
  "expect": {
    "approved": {
      "parser": false
    },
    "ready": []
  }
}
