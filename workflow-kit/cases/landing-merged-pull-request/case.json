{
  "title": "A merged pull request whose branch GitHub deleted is landed work awaiting its tick",
  "rules": ["12.1", "16.2", "16.5"],
  "runner": {
    "login": "acme-alice",
    "defaultBranch": "main",
    "specsBranch": "plans"
  },
  "origin": {
    "branches": ["main", "plans"],
    "behind": [],
    "graph": {
      "c1": [],
      "c2": ["c1"],
      "c3": ["c1"]
    },
    "heads": {
      "main": "c3"
    },
    "mergedPullHeads": ["avoozl/parser/p-2"]
  },
  "issues": {
    "parser": ["acme-alice"]
  },
  "land": {
    "task": "parser/p-2",
    "checks": "pass",
    "baseMoved": false,
    "mode": "pr",
    "claim": {
      "start": "c1",
      "head": "c2",
      "pull": {
        "merged": true,
        "head": "c2"
      }
    }
  },
  "expect": {
    "ready": [],
    "landed": true,
    "landing": {
      "action": "tick-landed-work",
      "base": "plans",
      "tick": "own-commit",
      "mergeBase": false,
      "deleteClaimBranch": true
    }
  }
}
