{
  "title": "A force push and a rebase of a shared branch are refused",
  "rules": ["16.4", "20.4"],
  "runner": {
    "login": "acme-alice",
    "defaultBranch": "main"
  },
  "origin": {
    "branches": ["main"],
    "behind": []
  },
  "issues": {
    "parser": ["acme-alice"]
  },
  "actions": [
    {
      "kind": "force-push"
    },
    {
      "kind": "rebase",
      "shared": true
    },
    {
      "kind": "rebase",
      "shared": false
    }
  ],
  "expect": {
    "limits": ["20.4", "20.4", null]
  }
}
