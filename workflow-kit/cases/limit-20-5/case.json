{
  "title": "A runner deletes only its own claim branch, with the task's leases",
  "rules": ["15.6", "20.5"],
  "runner": {
    "login": "acme-alice",
    "defaultBranch": "main"
  },
  "origin": {
    "branches": ["main"],
    "behind": []
  },
  "issues": {
    "parser": ["acme-alice"]
  },
  "actions": [
    {
      "kind": "delete-branch",
      "own": false,
      "landed": true
    },
    {
      "kind": "delete-branch",
      "own": true,
      "landed": false,
      "released": false
    },
    {
      "kind": "delete-branch",
      "own": true,
      "landed": true
    },
    {
      "kind": "delete-branch",
      "own": true,
      "released": true
    },
    {
      "kind": "delete-lease",
      "createdByRunner": false,
      "withOwnClaimBranch": false
    },
    {
      "kind": "delete-lease",
      "createdByRunner": false,
      "withOwnClaimBranch": true
    }
  ],
  "expect": {
    "limits": ["20.5", "20.5", null, null, "20.5", null]
  }
}
