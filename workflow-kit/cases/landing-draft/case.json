{
  "title": "A draft pull request is opened and never merged by the runner",
  "rules": ["17.2"],
  "runner": {
    "login": "acme-alice",
    "defaultBranch": "main"
  },
  "origin": {
    "branches": ["main", "avoozl/parser/p-2"],
    "behind": []
  },
  "issues": {
    "parser": ["acme-alice"]
  },
  "land": {
    "task": "parser/p-2",
    "checks": "pass",
    "baseMoved": false,
    "mode": "pr",
    "pr": "draft"
  },
  "expect": {
    "landing": {
      "action": "open-draft-pull-request",
      "base": "main",
      "tick": "same-commit",
      "mergeBase": false,
      "deleteClaimBranch": false
    }
  }
}
