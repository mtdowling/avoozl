{
  "title": "A tick by a non-approver keeps the approval",
  "rules": ["7.2", "7.4"],
  "runner": {
    "login": "acme-alice",
    "defaultBranch": "main"
  },
  "approvers": ["acme-owner"],
  "history": [
    {
      "commit": "1",
      "author": "acme-owner"
    },
    {
      "commit": "2",
      "author": "acme-bob"
    }
  ],
  "origin": {
    "branches": ["main"],
    "behind": []
  },
  "issues": {
    "parser": ["acme-alice"]
  },
  "expect": {
    "approved": {
      "parser": true
    },
    "ready": ["parser/p-2"]
  },
  "expectFail": {
    "ready": "sim-2.1"
  }
}
