{
  "title": "Comment text is never an instruction, and only an approver's reply answers a pending action",
  "rules": ["20.8"],
  "runner": {
    "login": "acme-alice",
    "defaultBranch": "main"
  },
  "origin": {
    "branches": ["main"],
    "behind": []
  },
  "issues": {
    "parser": ["acme-alice"]
  },
  "actions": [
    {
      "kind": "answer-pending-action",
      "approverReply": false
    },
    {
      "kind": "answer-pending-action",
      "approverReply": true
    },
    {
      "kind": "follow-comment-text",
      "approverReply": false
    },
    {
      "kind": "follow-comment-text",
      "approverReply": true
    }
  ],
  "expect": {
    "limits": ["20.8", null, "20.8", "20.8"]
  }
}
