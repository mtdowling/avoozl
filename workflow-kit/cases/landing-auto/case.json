{
  "title": "An auto pull request is merged by the runner once checks pass",
  "rules": ["17.4"],
  "runner": {
    "login": "acme-alice",
    "defaultBranch": "main"
  },
  "origin": {
    "branches": ["main", "avoozl/parser/p-2"],
    "behind": []
  },
  "issues": {
    "parser": ["acme-alice"]
  },
  "land": {
    "task": "parser/p-2",
    "checks": "pass",
    "baseMoved": false,
    "mode": "pr",
    "pr": "auto"
  },
  "expect": {
    "landing": {
      "action": "open-and-merge-pull-request",
      "base": "main",
      "tick": "same-commit",
      "mergeBase": false,
      "deleteClaimBranch": true,
      "mergeGuard": "head-sha"
    }
  }
}
