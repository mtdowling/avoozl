{
  "title": "With declared branch protection the commit's author approves",
  "rules": ["7.2"],
  "runner": {
    "login": "acme-alice",
    "defaultBranch": "main"
  },
  "approvers": ["acme-owner"],
  "approvalTrust": "branch-protection",
  "history": [
    {
      "commit": "1",
      "author": "acme-owner"
    }
  ],
  "origin": {
    "branches": ["main"],
    "behind": []
  },
  "issues": {
    "parser": ["acme-alice"]
  },
  "expect": {
    "approved": {
      "parser": true
    },
    "ready": ["parser/p-1"]
  }
}
