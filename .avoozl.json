{
  "$schema": "./src/avoozl-config.schema.json",
  "version": 1,
  "workspaceId": "avoozl",
  "name": "Avoozl",
  "specs": {
    "path": "specs"
  },
  "agentInstructions": {
    "rules": [
      {
        "id": "record-required-follow-up",
        "title": "Record required follow-up",
        "appliesTo": ["task.implement", "github.issue.implement"],
        "instruction": "When required work falls outside the authorized scope, record it through Avoozl instead of only mentioning it. Do not silently broaden the current task."
      },
      {
        "id": "review-substantive-risks",
        "title": "Review substantive risks",
        "appliesTo": ["github.pr.review", "task.review"],
        "instruction": "Prioritize correctness, feasibility, security, and missing acceptance coverage. Do not prolong review with purely stylistic nitpicks."
      },
      {
        "id": "complete-with-evidence",
        "title": "Complete with evidence",
        "appliesTo": ["task.complete"],
        "instruction": "Record the commit and relevant check results. Keep agent completion, integration, and acceptance as separate states."
      }
    ]
  },
  "repositories": {
    "avoozl": {
      "root": ".",
      "baseBranch": "main",
      "worktreeRoot": "../avoozl-worktrees",
      "checks": {
        "format": ["npm", "run", "format:check"],
        "test": ["npm", "run", "test:changed"],
        "typecheck": ["npm", "run", "typecheck"],
        "typecheck-ui": ["npm", "run", "typecheck:ui"],
        "dup": ["npm", "run", "dup:changed"],
        "nocheck": ["npm", "run", "nocheck"],
        "diff": ["git", "diff", "--check"]
      },
      "planning": false,
      "editable": true,
      "isolation": {
        "prepare": ["npm", "ci", "--ignore-scripts"]
      }
    }
  },
  "github": {
    "repositories": {
      "mtdowling/avoozl": {
        "baseBranch": "main",
        "requiredChecks": [
          "test (ubuntu-latest)",
          "test (macos-latest)",
          "test (windows-latest)"
        ],
        "landing": {
          "mode": "pr",
          "method": "squash"
        }
      }
    }
  }
}
