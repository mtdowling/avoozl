{
  "name": "claude-code",
  "start": [
    "claude",
    "-p",
    "--output-format",
    "json",
    "--session-id",
    "{session_uuid}",
    "--permission-mode",
    "{permission}"
  ],
  "resume": [
    "claude",
    "-p",
    "--output-format",
    "json",
    "--resume",
    "{session_uuid}",
    "--permission-mode",
    "{permission}"
  ],
  "attach": ["claude", "--resume", "{session_uuid}"],
  "promptFrom": "stdin",
  "model": ["--model", "{model}"],
  "permission": { "write": "acceptEdits", "read": "dontAsk" },
  "writeRoots": ["{worktree}", "{tmp}", "{repository_cache_dirs}"],
  "allow": ["--allowedTools", "Bash({repository_allow_commands}:*)"],
  "resultAllow": [
    "--allowedTools",
    "Edit(/{worktree}/.avoozl/result.json)",
    "--allowedTools",
    "Edit(/{worktree}/.avoozl/output/*)"
  ],
  "servedModel": { "from": "output", "field": "modelUsage" },
  "cost": { "from": "output", "field": "total_cost_usd", "per": "session" },
  "keepEnv": ["ANTHROPIC_API_KEY"],
  "reads": ["~/.claude", "~/.claude.json"],
  "tmpEnv": ["CLAUDE_CODE_TMPDIR"],
  "proved": ["read", "write"],
  "box": {
    "env": { "CLAUDE_CODE_SHELL_PREFIX": "{box_exec}" },
    "args": [
      "--setting-sources",
      "user",
      "--settings",
      "{box_settings}",
      "--strict-mcp-config",
      "--disallowedTools",
      "WebFetch",
      "--disallowedTools",
      "WebSearch"
    ],
    "hosts": ["api.anthropic.com:443", "platform.claude.com:443"],
    "signIn": {
      "darwin": "keychain",
      "linux": ["~/.claude/.credentials.json"]
    }
  }
}
