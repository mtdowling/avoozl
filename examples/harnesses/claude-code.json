{
  "name": "claude-code",
  "start": [
    "claude",
    "-p",
    "--output-format",
    "json",
    "--session-id",
    "{session_uuid}",
    "--permission-mode",
    "{permission}"
  ],
  "resume": [
    "claude",
    "-p",
    "--output-format",
    "json",
    "--resume",
    "{session_uuid}",
    "--permission-mode",
    "{permission}"
  ],
  "promptFrom": "stdin",
  "model": ["--model", "{model}"],
  "permission": { "write": "acceptEdits", "read": "plan" },
  "writeRoots": ["{worktree}", "{tmp}", "{project_cache_dirs}"],
  "allow": ["--allowedTools", "Bash({project_allow_commands})"],
  "cost": { "from": "output", "field": "total_cost_usd" },
  "spendCap": ["--max-budget-usd", "{budget_usd}"],
  "keepEnv": ["ANTHROPIC_API_KEY"]
}
