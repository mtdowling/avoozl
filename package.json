{
  "name": "aicommander",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node cli.mjs serve",
    "workspace": "node cli.mjs",
    "test": "node --test --test-timeout=60000 src/*.test.mjs src/app/test/*.test.mjs",
    "format": "prettier --write cli.mjs src examples scripts extension README.md AGENTS.md package.json .github",
    "format:check": "prettier --check cli.mjs src examples scripts extension README.md AGENTS.md package.json .github",
    "package:extension": "node scripts/package-extension.mjs",
    "fixture": "node scripts/vscode-fixture.mjs",
    "evidence": "node scripts/vscode-evidence.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@microsoft/agent-host-protocol": "^1.0.0",
    "ws": "^8.22.2"
  },
  "version": "0.1.0",
  "description": "Plans, tasks, and agents in one local workspace.",
  "license": "MIT",
  "bin": {
    "aicommander": "./cli.mjs"
  },
  "files": [
    "cli.mjs",
    "src/",
    "examples/",
    "README.md",
    "LICENSE",
    "docs/example-workspace.png",
    "extension/"
  ],
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtdowling/aicommander.git"
  },
  "homepage": "https://github.com/mtdowling/aicommander#readme"
}
