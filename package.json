{
  "name": "avoozl",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build:web": "vite build",
    "dev:web": "vite",
    "prepack": "npm run build:web",
    "prestart": "npm run build:web",
    "pretest": "npm run build:web",
    "start": "node cli.mjs serve",
    "workspace": "node cli.mjs",
    "test": "node --test --test-timeout=60000 src/*.test.mjs src/app/test/*.test.mjs",
    "format": "prettier --write cli.mjs src examples scripts extension README.md AGENTS.md package.json .github",
    "format:check": "prettier --check cli.mjs src examples scripts extension README.md AGENTS.md package.json .github",
    "package:extension": "node scripts/package-extension.mjs",
    "fixture": "node scripts/vscode-fixture.mjs",
    "evidence": "node scripts/vscode-evidence.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@assistant-ui/react": "^0.15.33",
    "@assistant-ui/react-markdown": "^0.14.25",
    "@microsoft/agent-host-protocol": "^1.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@openhands/agent-canvas": "1.38.0",
    "@openhands/typescript-client": "1.61.0",
    "lucide-react": "^1.70.0",
    "monaco-editor": "0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "8.5.1",
    "ws": "^8.22.2"
  },
  "version": "0.1.0",
  "description": "Plans, tasks, and agents in one local workspace.",
  "license": "MIT",
  "bin": {
    "avoozl": "./cli.mjs",
    "aicommander": "./cli.mjs"
  },
  "files": [
    "cli.mjs",
    "src/",
    "examples/",
    "README.md",
    "LICENSE",
    "docs/example-workspace.png",
    "extension/"
  ],
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "3.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtdowling/avoozl.git"
  },
  "homepage": "https://github.com/mtdowling/avoozl#readme"
}
