{
  "name": "avoozl",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "npm run build:kirocrew-app",
    "build:kirocrew-app": "node scripts/build-kirocrew-app.mjs",
    "build:agents": "node src/app/executors/kirocrew/build-agents.mjs",
    "check:agents": "node src/app/executors/kirocrew/build-agents.mjs --check",
    "prepack": "npm run build",
    "pretest": "node scripts/check-no-images.mjs && npm run check:agents && npm run build",
    "workspace": "node cli.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:map": "node scripts/build-test-map.mjs",
    "test:times": "node scripts/build-test-times.mjs",
    "pretest:ci": "npm run check:agents && npm run build",
    "test:ci": "node scripts/run-tests.mjs --ui",
    "test:changed": "node scripts/run-tests.mjs --changed",
    "test:ui": "node --test --test-timeout=60000 kirocrew-app/ui/test/*.test.mjs",
    "dup": "node scripts/dup.mjs",
    "dup:changed": "node scripts/dup.mjs --changed",
    "format": "biome format --write",
    "format:check": "biome format",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "dependencies": {
    "react": "^19.3.1"
  },
  "version": "0.1.0",
  "description": "Approve a spec; Avoozl runs it with coding agents, checks each commit itself, and lands it.",
  "license": "MIT",
  "bin": {
    "avoozl": "./cli.mjs"
  },
  "files": [
    "cli.mjs",
    "src/",
    "examples/",
    "prompts/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/policies.md",
    "docs/plugins.md",
    "docs/epic-types.md",
    "kirocrew-app/",
    "!src/**/test/",
    "!src/**/*.test.mjs",
    "!kirocrew-app/ui/test/"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/query-core": "5.96.0",
    "@tanstack/react-query": "5.96.0",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "clsx": "2.1.1",
    "framer-motion": "12.40.0",
    "html-parse-stringify": "4.0.1",
    "i18next": "26.4.4",
    "jscpd": "4.3.0",
    "lucide-react": "1.7.0",
    "motion-dom": "12.40.0",
    "motion-utils": "12.39.0",
    "prismjs": "1.30.0",
    "react-dom": "19.3.1",
    "react-dom18": "npm:react-dom@18.3.1",
    "react-i18next": "17.0.11",
    "react18": "npm:react@18.3.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^7.0.2",
    "use-sync-external-store": "1.6.0",
    "vite": "^8.3.7",
    "vitepress": "1.6.4",
    "void-elements": "3.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtdowling/avoozl.git"
  },
  "homepage": "https://github.com/mtdowling/avoozl#readme"
}
