{
  "name": "avoozl",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "npm run build:kirocrew-app",
    "build:kirocrew-app": "node scripts/build-kirocrew-app.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "workspace": "node cli.mjs",
    "test": "node --test --test-timeout=60000 src/*.test.mjs src/app/test/*.test.mjs",
    "test:ui": "node --test --test-timeout=60000 kirocrew-app/ui/test/*.test.mjs",
    "format": "prettier --write cli.mjs src examples scripts README.md AGENTS.md package.json .github",
    "format:check": "prettier --check cli.mjs src examples scripts README.md AGENTS.md package.json .github"
  },
  "dependencies": {
    "react": "^19.3.1"
  },
  "version": "0.1.0",
  "description": "Plans, tasks, and agents in one local workspace.",
  "license": "MIT",
  "bin": {
    "avoozl": "./cli.mjs",
    "aicommander": "./cli.mjs"
  },
  "files": [
    "cli.mjs",
    "src/",
    "examples/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/policies.md",
    "docs/plugins.md",
    "docs/epic-types.md",
    "kirocrew-app/",
    "!src/**/test/",
    "!src/**/*.test.mjs",
    "!kirocrew-app/ui/test/"
  ],
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "3.6.2",
    "prismjs": "1.30.0",
    "react-dom": "19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtdowling/avoozl.git"
  },
  "homepage": "https://github.com/mtdowling/avoozl#readme"
}
