[
  {
    "name": "avoozl-code-review",
    "model": "auto",
    "description": "Avoozl Code review: reviews one pull request with read-only tools and drafts comments in the chat. Posts nothing.",
    "tools": ["fs_read", "grep", "glob", "execute_bash", "thinking"],
    "allowedTools": [],
    "toolsSettings": {
      "execute_bash": {
        "denyByDefault": true,
        "allowedCommands": [
          "gh pr (view|diff|checks) [0-9]+ --repo [A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+( --comments)?",
          "gh issue view [0-9]+ --repo [A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+( --comments)?",
          "gh api repos/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/(pulls|issues)/[0-9]+(/(files|comments|reviews|commits))?"
        ]
      }
    },
    "includeMcpJson": false
  },
  {
    "name": "avoozl-conflict-fix",
    "model": "auto",
    "description": "Avoozl Conflict fix: merges the base branch into one crew pull request that has a source conflict, keeps both sides, runs the checks, and pushes one merge commit to the same branch. Never rebases or force pushes.",
    "tools": [
      "fs_read",
      "fs_write",
      "grep",
      "glob",
      "execute_bash",
      "thinking",
      "@avoozl:avoozl/plans_conflict_check",
      "@avoozl:avoozl/plans_conflict_report"
    ],
    "allowedTools": [],
    "toolsSettings": {
      "execute_bash": {
        "deniedCommands": [
          "git push .*--force.*",
          "git push .* -f( .*)?",
          "git push .* \\+.*",
          "git push .*--mirror.*",
          "git push .*--delete.*",
          "git rebase.*",
          "git reset.*"
        ]
      }
    },
    "includeMcpJson": false
  },
  {
    "name": "avoozl-crew",
    "model": "auto",
    "description": "Avoozl crew agent: an Issue Radar crew that verifies an issue with Avoozl before it builds.",
