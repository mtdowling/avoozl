      "@avoozl:avoozl/plans_documents",
      "@avoozl:avoozl/plans_get_document",
      "@avoozl:avoozl/plans_get_plan",
      "@avoozl:avoozl/plans_create_plan",
      "@avoozl:avoozl/plans_save_plan",
      "@avoozl:avoozl/plans_plan_review",
      "@avoozl:avoozl/plans_answer_review"
    ],
    "allowedTools": [],
    "toolsSettings": {
      "fs_write": {
        "fallbackAction": "deny",
        "allowedPaths": [".kiro/specs/**"]
      }
    },
    "includeMcpJson": false
  },
