{
  "name": "avoozl",
  "version": "1.3.0",
  "description": "Read authorized planning context and propose adjacent work through a run-scoped Avoozl capability.",
  "automation": {
    "schema_version": "openhands.automation.plugin.v1",
    "entrypoint": {
      "runner": "script",
      "working_dir": "scripts",
      "command": "python3 avoozl_github_intake.py"
    },
    "runtime": {
      "plugins": []
    },
    "config_schema": {
      "type": "object",
      "required": [
        "repositories",
        "mode",
        "repository_private",
        "callback_url",
        "ingest_secret_name"
      ],
      "additionalProperties": false,
      "properties": {
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          }
        },
        "mode": {
          "type": "string",
          "enum": ["authorization", "observation-only"]
        },
        "repository_private": {
          "type": "boolean"
        },
        "assignee": {
          "type": "string",
          "minLength": 1,
          "maxLength": 39,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
        },
        "ready_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "default": "avoozl:ready"
        },
        "schedule": {
          "type": "string",
          "minLength": 9,
          "maxLength": 100,
          "default": "*/5 * * * *"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "default": "UTC"
        },
        "callback_url": {
          "type": "string",
          "format": "uri",
          "minLength": 10,
          "maxLength": 2048
        },
        "ingest_secret_name": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
        },
        "github_secret_name": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]{0,127}$",
          "default": "GITHUB_PERSONAL_ACCESS_TOKEN"
        }
      }
    },
    "suggested_trigger": {
      "type": "cron",
      "schedule": "*/5 * * * *",
      "timezone": "UTC"
    }
  }
}
