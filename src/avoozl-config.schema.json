{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avoozl.dev/schema/repository-config-v1.json",
  "title": "Avoozl repository configuration",
  "description": "Shareable, non-secret policy stored as .avoozl.json at a repository root. Machine host configuration remains in ~/.config/avoozl/config.json and machine state remains under .avoozl/local.",
  "type": "object",
  "required": ["version"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "runner": {
      "$ref": "#/$defs/runner"
    },
    "version": {
      "const": 1
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,60}$",
      "description": "Stable portable identity used when this workspace is registered with a machine host."
    },
    "namespace": {
      "type": "string",
      "pattern": "^avz_[a-z0-9]{16}$",
      "description": "Opaque owner of this workspace's GitHub task IDs, written by avoozl init. Managed issue markers carry it; it never changes."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "planning": {
      "$ref": "#/$defs/planning"
    },
    "agentInstructions": {
      "$ref": "#/$defs/agentInstructions"
    },
    "operator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "dbPath": {
      "type": "string",
      "minLength": 1
    },
    "documents": {
      "type": "string",
      "minLength": 1
    },
    "port": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "canvasOrigins": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "uniqueItems": true
        }
      ]
    },
    "agentManifest": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "ahp": {
      "$ref": "#/$defs/ahp"
    },
    "conversations": {
      "$ref": "#/$defs/conversations"
    },
    "projects": {
      "description": "Machine-local execution repositories keyed by a stable project ID.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{1,60}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/project"
      }
    },
    "github": {
      "$ref": "#/$defs/github"
    },
    "review": {
      "$ref": "#/$defs/reviewPolicy"
    },
    "safety": {
      "$ref": "#/$defs/safetyPolicy"
    },
    "planningRepository": {
      "$ref": "#/$defs/planningRepository"
    },
    "plugins": {
      "description": "Route and tracker plugins this repository declares (design §4.8). A plugin loads only after a person approves its exact version and content hash on each machine. Declare a plugin whose name must stay private in this machine's plugins.json instead.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contract"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,60}$",
            "not": { "enum": ["local", "github"] }
          },
          "package": { "type": "string" },
          "path": {
            "type": "string",
            "description": "A folder relative to this file."
          },
          "git": {
            "type": "string",
            "description": "A repository URL or a local repository path relative to this file. Never a URL with credentials."
          },
          "ref": {
            "type": "string",
            "description": "A tag, branch or full commit. Each machine pins it to one commit when a person adds or updates the plugin."
          },
          "subdir": {
            "type": "string",
            "description": "The plugin's folder inside the git repository."
          },
          "contract": { "type": "integer" },
          "config": {
            "type": "object",
            "description": "Plain, non-secret data for the plugin. A key ending in Env names an environment variable the plugin reads a credential from."
          }
        },
        "oneOf": [
          { "required": ["package"] },
          { "required": ["path"] },
          { "required": ["git", "ref"] }
        ]
      }
    },
    "intake": {
      "description": "Sources other than GitHub that bring incoming items in (design §4.12). Declare a source whose name must stay private in this machine's plugins.json instead.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{0,60}$",
            "not": { "enum": ["github", "local"] }
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["via", "repository"],
            "properties": {
              "via": {
                "type": "string",
                "description": "plugin:<id> for a tracker plugin with poll, or mcp for callers of intake.submit.",
                "pattern": "^(mcp|plugin:[a-z][a-z0-9-]{0,60})$"
              },
              "repository": {
                "type": "string",
                "description": "The registered workspace repository whose rules apply and where a delivered item's task lands."
              },
              "labelFields": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "assigneeField": { "type": "string", "minLength": 1 },
              "allowedActors": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "minimumPermission": {
                "enum": ["read", "triage", "write", "maintain", "admin"]
              }
            }
          }
        }
      }
    },
    "activity": {
      "description": "The activity log. retentionDays is how many days rows are kept; each tick deletes older ones.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365,
          "default": 30
        }
      }
    },
    "delivery": {
      "description": "Turns on readiness dispatch of local leaves by the tick. Limits count sessions the tick opened that have not finished.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concurrency": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32,
          "default": 1
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 2
        },
        "quietMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440,
          "default": 15
        },
        "nudges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 3
        },
        "agent": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "default": "kirocrew-worker"
        },
        "runner": {
          "description": "Who starts worker sessions for ready leaves: the tick's script cron, or a Crew Mode conductor that claims them through avoozl next and claim. The tick verifies and integrates either way.",
          "enum": ["tick", "crew-mode"],
          "default": "tick"
        },
        "investigate": {
          "description": "Investigate before coding (design 4.21): the worker reports findings, a falsifier tries to refute them, and coding starts only at minConfidence.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": ["all", "not-small", "off"],
              "default": "not-small"
            },
            "minConfidence": { "enum": ["medium", "high"], "default": "high" },
            "agent": { "type": "string" },
            "model": { "type": "string" }
          }
        },
        "ship": {
          "description": "Who merges a finished pull request: the writer turns on GitHub auto-merge, or a person merges it (design 4.25).",
          "enum": ["auto-merge", "manual"],
          "default": "auto-merge"
        },
        "repositories": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "concurrency": { "type": "integer", "minimum": 0, "maximum": 32 }
            }
          }
        }
      }
    },
    "ahpPort": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "deprecated": true
    },
    "ahpHost": {
      "type": "string",
      "minLength": 1,
      "deprecated": true
    },
    "ahpProjection": {
      "type": "string",
      "minLength": 1,
      "deprecated": true
    },
    "ahpTokens": {
      "type": "string",
      "minLength": 1,
      "deprecated": true
    },
    "ahpManifest": {
      "type": "string",
      "minLength": 1,
      "deprecated": true
    },
    "packs": {
      "type": "object",
      "description": "Written by a pack import (design §4.14): for each plugin whose pack was imported, the version and time of the import and the settings that came from it. Records provenance only; Avoozl never re-applies it.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": { "type": "string" },
          "importedAt": { "type": "string" },
          "importedBy": { "type": "string" },
          "settings": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "propertyNames": {
    "$ref": "#/$defs/safePropertyName"
  },
  "additionalProperties": {
    "$ref": "#/$defs/safeValue"
  },
  "$defs": {
    "runner": {
      "type": "object",
      "description": "Runner mode over SSH, off unless role is set. A runner runs tasks a driver hands it. Machine paths (repos) and a local stand-in for ssh belong in ~/.config/avoozl/config.json.",
      "properties": {
        "role": { "enum": ["runner", "driver"] },
        "crewId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
        },
        "agents": { "type": "array", "items": { "type": "string" } },
        "remote": { "type": "string" },
        "checkTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "checks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["argv"],
            "properties": {
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              }
            }
          }
        },
        "repos": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        },
        "hosts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "ssh": { "type": "string" },
              "command": { "type": "string" },
              "dashboardUrl": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "safePropertyName": {
      "anyOf": [
        {
          "enum": ["ahpTokens"]
        },
        {
          "not": {
            "pattern": "(^|[-_])(api[-_]?key|access[-_]?key|private[-_]?key|client[-_]?secret|secret|password|passwd|token|credential)s?($|[-_])"
          }
        }
      ]
    },
    "safeValue": {
      "anyOf": [
        {
          "type": ["string", "number", "integer", "boolean", "null"]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safeValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/safePropertyName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/safeValue"
          }
        }
      ]
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^(?:/|\\\\\\\\|[A-Za-z]:[\\\\/])"
      },
      "description": "A path relative to the repository root. Absolute machine paths belong in ~/.config/avoozl/config.json."
    },
    "repository": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,60}$"
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": ["planning", "code"]
          },
          "uniqueItems": true
        },
        "baseBranch": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "planning": {
      "type": "object",
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/portablePath"
          },
          "uniqueItems": true
        },
        "exclude": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/portablePath"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "agentInstructions": {
      "type": "object",
      "required": ["rules"],
      "properties": {
        "rules": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/agentInstructionRule"
          }
        }
      },
      "additionalProperties": false
    },
    "agentInstructionRule": {
      "type": "object",
      "required": ["id", "title", "appliesTo", "instruction"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,79}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "enum": [
              "all",
              "chat",
              "chat.project",
              "chat.scoped",
              "plan",
              "plan.create",
              "plan.edit",
              "plan.extract",
              "plan.review",
              "plan.publish",
              "task",
              "task.create",
              "task.create.scoped",
              "task.implement",
              "task.review",
              "task.complete",
              "github",
              "github.issue",
              "github.issue.triage",
              "github.issue.implement",
              "github.pr",
              "github.pr.review"
            ]
          }
        },
        "when": {
          "$ref": "#/$defs/agentInstructionWhen"
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "enabled": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "agentInstructionWhen": {
      "type": "object",
      "properties": {
        "scopes": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "epics": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "tracks": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "tagsAny": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "tagsAll": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "tagsNone": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "paths": {
          "$ref": "#/$defs/uniqueStrings"
        }
      },
      "additionalProperties": false
    },
    "uniqueStrings": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "ahp": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "projection": {
          "type": "string",
          "minLength": 1
        },
        "tokens": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the generated AHP token file; never an inline token."
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/safeValue"
      }
    },
    "conversations": {
      "type": "object",
      "properties": {
        "autoArchiveCompleted": {
          "type": "boolean",
          "default": true,
          "description": "Archive completed child and task conversations while retaining their task and transcript links."
        },
        "driver": {
          "type": "object",
          "properties": {
            "agentProfile": {
              "type": ["string", "null"],
              "minLength": 1,
              "description": "OpenHands agent profile used when a new Driver conversation is created."
            },
            "model": {
              "type": ["string", "null"],
              "minLength": 1,
              "description": "OpenHands LLM profile or ACP model override used for a new Driver conversation."
            }
          },
          "additionalProperties": false
        },
        "routing": {
          "$ref": "#/$defs/agentRouting"
        }
      },
      "additionalProperties": false
    },
    "agentRouting": {
      "type": "object",
      "description": "Deterministic agent and model selection policy. Explicit per-run choices always win.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "fallback": {
          "$ref": "#/$defs/agentRouteChoice"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agentRouteRule"
          }
        }
      },
      "additionalProperties": false
    },
    "agentRouteChoice": {
      "type": "object",
      "properties": {
        "agentProfile": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "model": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "agentRouteRule": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,60}$"
        },
        "priority": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "risks": {
          "type": "array",
          "items": {
            "enum": ["low", "medium", "high", "unspecified"]
          },
          "uniqueItems": true
        },
        "contextRemainingAtMost": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "agentProfile": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "model": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": ["root"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "baseBranch": {
          "type": "string",
          "minLength": 1
        },
        "integrationBranch": {
          "type": "string",
          "minLength": 1
        },
        "worktreeRoot": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "planning": {
          "type": "boolean",
          "default": false,
          "description": "This repository contributes Markdown planning documents."
        },
        "editable": {
          "type": "boolean",
          "default": true,
          "description": "Agents may create worktrees and prepare changes in this checkout."
        }
      },
      "additionalProperties": false
    },
    "github": {
      "type": "object",
      "description": "Desired non-secret GitHub configuration: mode, task authority, Project, and per-repository policy (design §4.4), plus the older issue intake and Queue settings. Remote setup remains an explicit action.",
      "properties": {
        "issueIntake": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[^/]+/[^/]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/githubIssueIntake"
          }
        },
        "queue": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[^/]+/[^/]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/githubQueueRepository"
          }
        },
        "mode": {
          "enum": ["local", "plans-repo", "single-repo"],
          "description": "Where issues live. local, or absent, means every task is local; GitHub settings stored beside local are kept but not used."
        },
        "planningRepository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "description": "Planning repository for plans-repo mode; kept but not used in other modes."
        },
        "defaultAuthority": {
          "enum": ["github", "local"],
          "description": "Authority of new tasks. Defaults to github when a mode is set, else local."
        },
        "project": {
          "$ref": "#/$defs/githubProject"
        },
        "epicIssueType": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "repositories": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/githubRepositoryPolicy"
          }
        }
      },
      "additionalProperties": false
    },
    "githubProject": {
      "type": "object",
      "required": ["owner", "number"],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "fields": {
          "type": "object",
          "properties": {
            "status": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "release": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "wave": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "iteration": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "avoozlState": {
              "type": ["string", "null"],
              "minLength": 1,
              "description": "Single-select field Avoozl fills with its Delivery state. Blank: Avoozl skips it."
            }
          },
          "additionalProperties": false
        },
        "statusValues": {
          "type": "object",
          "description": "Project Status option names. Only deferred is read as an order.",
          "properties": {
            "todo": {
              "type": "string",
              "minLength": 1
            },
            "inProgress": {
              "type": "string",
              "minLength": 1
            },
            "done": {
              "type": "string",
              "minLength": 1
            },
            "deferred": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "githubRepositoryPolicy": {
      "type": "object",
      "description": "Who may trigger work in one repository and which labels do what. No label name is built in.",
      "properties": {
        "checkout": {
          "type": "string",
          "minLength": 1
        },
        "folder": {
          "type": "string",
          "minLength": 1
        },
        "baseBranch": {
          "type": "string",
          "minLength": 1,
          "description": "Must equal the repository's default branch when a mode is set."
        },
        "coder": {
          "enum": ["worker", "issue-radar"],
          "description": "Who codes the issues: issue-radar or worker, in either GitHub mode."
        },
        "radar": {
          "type": "object",
          "description": "Issue Radar coder labels. Planning, needs-human, claim, ready, conflict and approval names must all differ.",
          "properties": {
            "planLabel": {
              "type": "string",
              "minLength": 1,
              "default": "to plan"
            },
            "conflictLabel": {
              "type": "string",
              "minLength": 1,
              "default": "merge conflict"
            },
            "approvalLabel": {
              "type": "string",
              "minLength": 1,
              "default": "plan approved"
            },
            "clearPlanLabel": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        },
        "allowedActors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minimumPermission": {
          "enum": ["read", "triage", "write", "maintain", "admin"]
        },
        "requiredChecks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 1
        },
        "dependencyText": {
          "type": "boolean",
          "default": false
        },
        "priority": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "priorityLabels": {
          "type": "array",
          "description": "Labels in priority order. They order tasks inside Ready and Up next, never the lane. The newer name for priority; set only one of the two.",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "waitingLabels": {
          "type": "array",
          "description": "Labels that mean the item waits on someone outside, such as response-requested. A task whose item has one waits in Blocked or waiting with the reason Waiting on the author.",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "managedLabels": {
          "type": "object",
          "description": "Labels Avoozl adds and removes. Each must differ from every trigger label.",
          "properties": {
            "managed": {
              "type": "string",
              "minLength": 1
            },
            "responding": {
              "type": "string",
              "minLength": 1
            },
            "planning": {
              "type": "string",
              "minLength": 1
            },
            "ready": {
              "type": "string",
              "minLength": 1
            },
            "stale": {
              "type": "string",
              "minLength": 1
            },
            "decision": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/githubRule"
          }
        }
      },
      "additionalProperties": false
    },
    "githubRule": {
      "type": "object",
      "required": ["id", "action"],
      "description": "Matches when every labelsAll label, one labelsAny label (when given), no labelsNone label, and the assignee and author hold, and the newest event that made it true came from an allowed actor.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,60}$"
        },
        "action": {
          "enum": [
            "respond",
            "plan",
            "deliver",
            "execute",
            "pause",
            "resume",
            "quarantine"
          ]
        },
        "labelsAll": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "labelsAny": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "labelsNone": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assignee": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "autoPublishChildren": {
          "type": "boolean",
          "default": false
        }
      },
      "anyOf": [
        {
          "required": ["labelsAll"]
        },
        {
          "required": ["labelsAny"]
        }
      ],
      "additionalProperties": false
    },
    "githubIssueIntake": {
      "type": "object",
      "required": ["projectId", "assignee"],
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "workspaceRepositoryId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ID used by the unified Repositories settings surface."
        },
        "assignee": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "default": "avoozl:ready"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "autoStart": {
          "type": "boolean",
          "default": false
        },
        "provider": {
          "type": ["string", "null"]
        },
        "model": {
          "type": ["string", "null"]
        },
        "allowedActors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minimumPermission": {
          "enum": ["write", "maintain", "admin"],
          "default": "write"
        }
      },
      "additionalProperties": false
    },
    "githubQueueRepository": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": ["string", "null"]
        },
        "workspaceRepositoryId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ID used by the unified Repositories settings surface."
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "includeIssues": {
          "type": "boolean",
          "default": true
        },
        "includePullRequests": {
          "type": "boolean",
          "default": true
        },
        "labelBehaviors": {
          "$ref": "#/$defs/githubLabelBehaviors"
        },
        "visibility": {
          "enum": ["private", "public"],
          "default": "private",
          "description": "Public Queue sources are metadata-only and never authorize or mutate GitHub."
        }
      },
      "additionalProperties": false
    },
    "githubLabelBehaviors": {
      "type": "object",
      "description": "Repository-specific GitHub labels mapped to normalized Avoozl Queue states. Omitted behaviors use the avoozl:* defaults.",
      "properties": {
        "ready": {
          "$ref": "#/$defs/githubLabelList"
        },
        "blocked": {
          "$ref": "#/$defs/githubLabelList"
        },
        "review": {
          "$ref": "#/$defs/githubLabelList"
        },
        "quarantined": {
          "$ref": "#/$defs/githubLabelList"
        }
      },
      "additionalProperties": false
    },
    "githubLabelList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewPolicy": {
      "type": "object",
      "description": "Repository review policy. Unmatched changes use the most restrictive configured class.",
      "properties": {
        "requiredChecks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excludeAuthor": {
          "type": "boolean",
          "default": true
        },
        "excludeImplementer": {
          "type": "boolean",
          "default": true
        },
        "defaultClass": {
          "enum": ["mechanical", "low-risk", "normal", "high-consequence"],
          "default": "high-consequence"
        },
        "classes": {
          "type": "object",
          "properties": {
            "mechanical": {
              "$ref": "#/$defs/reviewClass"
            },
            "low-risk": {
              "$ref": "#/$defs/reviewClass"
            },
            "normal": {
              "$ref": "#/$defs/reviewClass"
            },
            "high-consequence": {
              "$ref": "#/$defs/reviewClass"
            }
          },
          "additionalProperties": false
        },
        "agentReviewer": {
          "type": "object",
          "properties": {
            "mustDifferBy": {
              "enum": ["provider", "model"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "reviewClass": {
      "type": "object",
      "properties": {
        "humans": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "agents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "notifyHuman": {
          "type": "boolean"
        },
        "agentIsAdvisory": {
          "type": "boolean"
        },
        "requireHumanAcceptance": {
          "type": "boolean"
        },
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/portablePath"
          }
        }
      },
      "additionalProperties": false
    },
    "safetyPolicy": {
      "type": "object",
      "description": "Non-secret andon authority and optional coordinator enforcement. Authority is denied when no rule matches.",
      "properties": {
        "coordinator": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": ["local", "optional", "strict"],
              "default": "optional",
              "description": "Strict mode requires exact coordinator generation and safety-epoch fencing for distributed protected operations."
            }
          },
          "additionalProperties": false
        },
        "authority": {
          "type": "object",
          "properties": {
            "rules": {
              "type": "array",
              "maxItems": 200,
              "description": "Ordered policy rules. A matching deny overrides allows; no match denies.",
              "items": {
                "$ref": "#/$defs/safetyAuthorityRule"
              }
            },
            "separationOfDuty": {
              "$ref": "#/$defs/safetySeparationOfDuty"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "safetyAuthorityRule": {
      "type": "object",
      "required": ["id", "activities", "scopes"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,79}$"
        },
        "effect": {
          "enum": ["allow", "deny"],
          "default": "allow"
        },
        "activities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "raise",
              "diagnose",
              "remediate",
              "review",
              "resolve",
              "resume"
            ]
          }
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["task", "project", "workspace"]
          }
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "default": ["*"]
        },
        "identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "anyOf": [{ "required": ["identities"] }, { "required": ["roles"] }],
      "additionalProperties": false
    },
    "safetySeparationOfDuty": {
      "type": "object",
      "properties": {
        "reviewerDistinctFrom": {
          "$ref": "#/$defs/safetyDutyList"
        },
        "resolverDistinctFrom": {
          "$ref": "#/$defs/safetyDutyList"
        },
        "resumerDistinctFrom": {
          "$ref": "#/$defs/safetyDutyList"
        },
        "resolutionReviewRequired": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "safetyDutyList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["raiser", "requester", "implementer", "reviewer", "resolver"]
      }
    },
    "planningRepository": {
      "type": "object",
      "required": ["root", "remote"],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "default": "main"
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "default": "."
        }
      },
      "additionalProperties": false
    }
  }
}
