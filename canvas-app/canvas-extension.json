{
  "schema_version": 1,
  "name": "avoozl",
  "display_name": "Avoozl",
  "version": "0.1.17",
  "description": "Design review, GitHub work authorization, and acceptance for OpenHands.",
  "entrypoint": "extension.js",
  "icon": "icon-red.svg",
  "backend": {
    "schema_version": 1,
    "artifacts": {
      "linux-amd64": {
        "path": "backend/avoozl-linux-amd64.tar.gz",
        "sha256": "16f54d574a3f891c2ed962c87716c1f7f6141ef1c63a8c528a1c0e63043d4e62"
      },
      "linux-arm64": {
        "path": "backend/avoozl-linux-arm64.tar.gz",
        "sha256": "16f54d574a3f891c2ed962c87716c1f7f6141ef1c63a8c528a1c0e63043d4e62"
      }
    },
    "argv": [
      "{artifact_dir}/bin/avoozl-backend",
      "--workspace",
      "{data_dir}/workspace",
      "--port",
      "{port}"
    ],
    "health": {
      "path": "/api/health",
      "timeout_seconds": 30,
      "interval_seconds": 0.1
    },
    "inherit_environment": [
      "LANG",
      "LC_ALL",
      "LC_CTYPE",
      "PATH",
      "TMPDIR",
      "TZ"
    ]
  },
  "contributes": {
    "pages": [
      {
        "id": "workspace",
        "title": "Avoozl",
        "path": "/workspace"
      }
    ]
  }
}
